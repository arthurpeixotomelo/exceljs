{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny",
    "restriction": "deny",
    "suspicious": "deny",
    "perf": "warn",
    "pedantic": "warn",
    "style": "warn"
  },
  "env": {
    "worker": true,
    "serviceworker": true,
    "shared-node-browser": true
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "spec/manual/public/"
  ],
  "plugins": [
    "import", 
    "jsdoc", 
    "jsx-a11y", 
    "node", 
    "promise", 
    "vitest"
  ]
}