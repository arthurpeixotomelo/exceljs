{
  "name": "exceljs",
  "version": "4.4.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./excel.js",
  "types": "./index.d.ts",
  "files": [
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:end-to-end",
    "test:unit": "mocha spec/unit --recursive",
    "test:integration": "mocha spec/integration --recursive",
    "test:end-to-end": "mocha spec/end-to-end --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "mocha spec/typescript/**/*.spec.ts",
    "lint": "eslint --format node_modules/eslint-friendly-formatter .",
    "lint:fix": "prettier-eslint --write $(pwd)'/**/*.js'",
    "lint:staged": "lint-staged",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier-eslint --write",
      "eslint --format node_modules/eslint-friendly-formatter",
      "git add"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^5.0.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^4.3.1",
    "jszip": "^3.10.1",
    "saxes": "^5.0.1",
    "unzipper": "^0.10.11"
  },
  "devDependencies": {
    "@types/chai": "^4.2.12",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.2.0",
    "chai-datetime": "^1.7.0",
    "chai-xml": "^0.4.1",
    "dirty-chai": "^2.0.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "express": "^4.16.4",
    "got": "^14.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "mocha": "^10.0.0",
    "prettier-eslint": "^16.0.0",
    "prettier-eslint-cli": "^8.0.0",
    "sax": "^1.2.4",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
