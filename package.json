{
  "name": "ts-sheet",
  "version": "0.0.1",
  "description": "Typescript lib Rewrite of ExcelJS",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurpeixotomelo/ts-sheet.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./excel.js",
  "types": "./index.d.ts",
  "files": [
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "test:unit": "vitest --dir tests/unit",
    "test:perf": "vitest --dir tests/perf",
    "test:bench": "node --expose-gc --inspect-brk tests/benchmark",
    "test:integration": "vitest --dir tests/integration",
    "test:e2e": "vitest --dir tests/e2e",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "lint": "pnpm oxlint --type-aware",
    "lint:fix": "pnpm oxlint --fix",
    "lint:fix-all": "pnpm oxlint --fix --fix-suggestions"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "7.0.1",
    "dayjs": "1.11.19",
    "fast-csv": "5.0.5",
    "jszip": "3.10.1",
    "saxes": "6.0.0",
    "unzipper": "0.12.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "fast-xml-parser": "5.3.2",
    "oxlint": "1.29.0",
    "oxlint-tsgolint": "0.8.0",
    "sax": "1.4.3",
    "typescript": "5.9.3",
    "vitest": "4.0.13"
  },
  "packageManager": "pnpm@10.21.0"
}
